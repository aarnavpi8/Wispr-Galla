# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.db

# Node / Next.js (frontend/.gitignore has the rest)
node_modules/
.next/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Terraform (state can hold resource details; never commit it)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl.bak
crash.log

# Built Android app (share it, don't commit it)
*.apk
# Firebase Android config (project-specific; each developer downloads their own)
frontend/android/app/google-services.json
