# Copy to .env only if you want the optional extras. The app starts without a .env file.

# Optional LLM upgrade for understanding entries. Leave empty to use the built-in rules.
LLM_PROVIDER=
LLM_API_KEY=your-key-here

# Optional Wispr Flow speech-to-text for the in-app mic (https://platform.wisprflow.ai,
# access needs approval: enterprise@wisprflow.ai). Empty = the browser's own speech recognition.
WISPR_API_KEY=

# Optional Google login (Firebase Authentication). Leave all four empty to turn login off;
# the app then opens straight to the demo shop. These are Firebase's public web-app values
# (Firebase console -> Project settings -> Your apps -> Web app -> SDK setup and configuration).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Local dev only (Docker Compose sets these itself).
# DATABASE_URL=sqlite:///./galla.db
# API_URL=http://localhost:8000
